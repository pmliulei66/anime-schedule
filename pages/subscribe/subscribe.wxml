<view class="container">
  <!-- 加载动画 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-cat">🐱</text>
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中哦喵~</text>
  </view>

  <!-- 主内容 -->
  <block wx:if="{{!loading}}">
  <view class="content-fade-in">
  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{subscribeCount}}</text>
      <text class="stat-label">订阅番剧</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{todayUpdateCount}}</text>
      <text class="stat-label">今日更新</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{weekUpdateCount}}</text>
      <text class="stat-label">本周更新</text>
    </view>
  </view>

  <!-- 推送通知设置 -->
  <view class="notification-card">
    <view class="notification-header">
      <view class="notification-left">
        <text class="notification-icon">🔔</text>
        <view class="notification-info">
          <text class="notification-title">更新推送</text>
          <text class="notification-desc">订阅番剧更新时自动通知</text>
        </view>
      </view>
      <switch 
        class="notification-switch"
        checked="{{notificationEnabled}}"
        bindchange="toggleNotification"
        color="#4A90D9">
      </switch>
    </view>
  </view>

  <!-- 订阅列表 -->
  <view class="anime-list" wx:if="{{subscribedAnime.length > 0}}">
    <view class="waterfall-container">
      <!-- 左列 -->
      <view class="waterfall-column">
        <view 
          wx:for="{{leftColumn}}"
          wx:key="id"
          class="anime-card"
          bindtap="goToDetail"
          data-id="{{item.id}}">
          <image class="anime-cover" src="{{item.cover}}" mode="widthFix"></image>
          <view class="card-info">
            <text class="anime-name">{{item.name}}</text>
            <view class="card-meta">
              <view class="episode-badge">第{{item.currentEpisode}}集</view>
              <view class="rating-badge" wx:if="{{item.rating}}">⭐ {{item.rating}}</view>
            </view>
            <view class="card-day" wx:if="{{item.broadcastDayText}}">{{item.broadcastDayText}}</view>
          </view>
          <view class="unsubscribe-float" catchtap="unsubscribe" data-id="{{item.id}}">
            <text>✕</text>
          </view>
        </view>
      </view>
      <!-- 右列 -->
      <view class="waterfall-column">
        <view 
          wx:for="{{rightColumn}}"
          wx:key="id"
          class="anime-card"
          bindtap="goToDetail"
          data-id="{{item.id}}">
          <image class="anime-cover" src="{{item.cover}}" mode="widthFix"></image>
          <view class="card-info">
            <text class="anime-name">{{item.name}}</text>
            <view class="card-meta">
              <view class="episode-badge">第{{item.currentEpisode}}集</view>
              <view class="rating-badge" wx:if="{{item.rating}}">⭐ {{item.rating}}</view>
            </view>
            <view class="card-day" wx:if="{{item.broadcastDayText}}">{{item.broadcastDayText}}</view>
          </view>
          <view class="unsubscribe-float" catchtap="unsubscribe" data-id="{{item.id}}">
            <text>✕</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{subscribedAnime.length === 0 && !loading}}" class="empty-state">
    <text class="empty-icon">📭</text>
    <text class="empty-title">暂无订阅</text>
    <text class="empty-desc">去时间表页面订阅你喜欢的番剧吧</text>
    <button class="empty-btn" bindtap="goToIndex">去订阅</button>
  </view>
  </view>
  </block>
</view>
