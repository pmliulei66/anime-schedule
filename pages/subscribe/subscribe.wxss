.container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 40rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background-color: #4A90D9;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  color: #ffffff;
  margin: 20rpx 20rpx 16rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  background-color: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

/* 推送通知卡片 */
.notification-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 0 20rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.notification-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notification-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.notification-icon {
  font-size: 48rpx;
}

.notification-info {
  display: flex;
  flex-direction: column;
}

.notification-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.notification-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.notification-switch {
  transform: scale(0.9);
}

.notification-hint {
  font-size: 22rpx;
  color: #E6A23C;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background-color: #FFF8E6;
  border-radius: 8rpx;
}

.auth-btn {
  margin-top: 16rpx;
  background-color: #4A90D9;
  color: #ffffff;
  font-size: 28rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  border: none;
}

/* 瀑布流列表 - 与首页一致 */
.anime-list {
  padding: 0 16rpx;
}

.waterfall-container {
  display: flex;
  gap: 16rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.anime-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.anime-cover {
  width: 100%;
  display: block;
}

.card-info {
  padding: 16rpx;
}

.anime-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.episode-badge {
  font-size: 22rpx;
  color: #67C23A;
  background-color: #F0F9EB;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.rating-badge {
  font-size: 22rpx;
  color: #E6A23C;
}

.card-day {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 取消订阅按钮 - 浮动在右上角 */
.unsubscribe-float {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  z-index: 10;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

.empty-btn {
  background-color: #4A90D9;
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}
