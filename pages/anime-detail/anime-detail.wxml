<view class="container">
  <!-- 加载动画 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-cat">🐱</text>
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中哦喵~</text>
  </view>

  <!-- 主内容 -->
  <block wx:if="{{!loading}}">
  <view class="content-fade-in">
  <!-- 封面图：按原始比例全宽展示 -->
  <view class="cover-wrapper">
    <image 
      class="cover-image" 
      src="{{anime.cover}}" 
      mode="widthFix"
      bindload="onCoverLoad">
    </image>
    <!-- 顶部渐变遮罩（用于返回按钮可见性） -->
    <view class="cover-top-mask"></view>
    <!-- 底部渐变遮罩 + 信息叠加 -->
    <view class="cover-bottom-mask">
      <view class="title-section">
        <text class="anime-title">{{anime.name}}</text>
        <text class="anime-title-jp" wx:if="{{anime.nameJp}}">{{anime.nameJp}}</text>
        <view class="meta-line">
          <view class="status-tag {{anime.status}}">{{anime.statusText}}</view>
          <text class="meta-text" wx:if="{{anime.rating}}">⭐ {{anime.rating}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷信息卡片 -->
  <view class="module-card quick-info-card">
    <view class="info-item" wx:if="{{anime.broadcastDayText}}">
      <text class="info-icon">📅</text>
      <text class="info-label">播出</text>
      <text class="info-value">{{anime.broadcastDayText}}</text>
    </view>
    <view class="info-item" wx:if="{{anime.currentEpisode && anime.status === 'airing'}}">
      <text class="info-icon">📺</text>
      <text class="info-label">更新至</text>
      <text class="info-value">第{{anime.currentEpisode}}集</text>
    </view>
    <view class="info-item" wx:if="{{anime.totalEpisodes}}">
      <text class="info-icon">🎞️</text>
      <text class="info-label">全</text>
      <text class="info-value">共{{anime.totalEpisodes}}集</text>
    </view>
    <view class="info-item" wx:if="{{anime.latestUpdateDate}}">
      <text class="info-icon">🕐</text>
      <text class="info-label">最近更新</text>
      <text class="info-value">{{anime.latestUpdateDate}}</text>
    </view>
    <view class="info-item" wx:if="{{anime.startDate}}">
      <text class="info-icon">🎬</text>
      <text class="info-label">开播</text>
      <text class="info-value">{{anime.startDate}}</text>
    </view>
  </view>

  <!-- 标签 -->
  <view class="module-card tags-section" wx:if="{{anime.genre.length > 0}}">
    <view class="tags-scroll">
      <text wx:for="{{anime.genre}}" wx:for-item="tag" wx:key="index" class="genre-tag">{{tag}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="module-card action-bar">
    <view class="action-btn {{isSubscribed ? 'subscribed' : ''}}" catchtap="toggleSubscribe">
      <text class="btn-icon">{{isSubscribed ? '✓' : '+'}}</text>
      <text class="btn-text">{{isSubscribed ? '已订阅' : '订阅'}}</text>
    </view>
  </view>

  <!-- 简介 -->
  <view class="section-card">
    <text class="section-title">简介</text>
    <text class="intro-text">{{anime.description || '暂无简介'}}</text>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
  </view>
  </block>
</view>
