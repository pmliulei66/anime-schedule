.container {
  min-height: 100vh;
  background-color: #FEFCF3;
  background-image: radial-gradient(circle, #D8D4C8 1rpx, transparent 1rpx);
  background-size: 30rpx 30rpx;
}

/* 封面区域 */
.cover-wrapper {
  position: relative;
  margin: 0 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #1a1a1a;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

.cover-image {
  width: 100%;
  display: block;
}

.cover-top-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent);
  pointer-events: none;
}

.cover-bottom-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 24rpx 24rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.6) 60%, transparent 100%);
}

.title-section {
  color: #ffffff;
}

.anime-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.3;
  text-shadow: 4rpx 4rpx 0rpx rgba(0,0,0,0.5);
}

.anime-title-jp {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}

.meta-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  color: #1A1A1A;
  border: 4rpx solid #1A1A1A;
}

.status-tag.airing { background-color: #C8FF00; }
.status-tag.finished { background-color: #909399; color: #ffffff; }
.status-tag.upcoming { background-color: #E6A23C; }

.meta-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

/* 通用模块卡片样式 - 统一宽度 */
.module-card {
  margin: 16rpx 24rpx 0;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

/* 快捷信息卡片 */
.quick-info-card {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.info-icon {
  font-size: 36rpx;
}

.info-label {
  font-size: 22rpx;
  color: #1A1A1A;
}

.info-value {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 500;
}

/* 标签区域 */
.tags-section {
  padding: 20rpx 24rpx;
}

.tags-scroll {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.genre-tag {
  font-size: 24rpx;
  color: #1A1A1A;
  background-color: #E8E4D8;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  border: 4rpx solid #1A1A1A;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background-color: #C8FF00;
  color: #1A1A1A;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

.action-btn.subscribed {
  background-color: #C8FF00;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 简介卡片 */
.section-card {
  margin: 16rpx 24rpx 0;
  padding: 28rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  display: block;
}

/* 简介 */
.intro-text {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.8;
}

/* 底部安全区 */
.safe-bottom {
  height: 60rpx;
}
