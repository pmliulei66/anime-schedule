.container {
  min-height: 100vh;
  background-color: #F7F8FA;
}

/* 封面区域：全宽按比例展示 */
.cover-wrapper {
  position: relative;
  width: 100%;
  background-color: #1a1a1a;
}

.cover-image {
  width: 100%;
  display: block;
}

.cover-top-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent);
  pointer-events: none;
}

.cover-bottom-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 32rpx 32rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.6) 60%, transparent 100%);
}

.title-section {
  color: #ffffff;
}

.anime-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.3;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}

.anime-title-jp {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}

.meta-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  color: #ffffff;
}

.status-tag.airing { background-color: #67C23A; }
.status-tag.finished { background-color: #909399; }
.status-tag.upcoming { background-color: #E6A23C; }

.meta-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

/* 快捷信息卡片 */
.quick-info-card {
  display: flex;
  justify-content: space-around;
  padding: 28rpx 20rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.info-icon {
  font-size: 36rpx;
}

.info-label {
  font-size: 22rpx;
  color: #999999;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

/* 标签区域 */
.tags-section {
  padding: 20rpx 32rpx;
  background-color: #ffffff;
}

.tags-scroll {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.genre-tag {
  font-size: 24rpx;
  color: #666666;
  background-color: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
  margin-bottom: 16rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background-color: #4A90D9;
  color: #ffffff;
}

.action-btn.subscribed {
  background-color: #67C23A;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 通用卡片区块 */
.section-card {
  margin: 16rpx 24rpx;
  padding: 28rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
  display: block;
}

/* 简介 */
.intro-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

/* 底部安全区 */
.safe-bottom {
  height: 60rpx;
}
