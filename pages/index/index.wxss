.container {
  min-height: 100vh;
  background-color: transparent;
}

/* ==================== 搜索栏 ==================== */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FEFCF3;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border: 4rpx solid #1A1A1A;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}

.clear-btn {
  font-size: 24rpx;
  color: #999999;
  padding: 8rpx;
}

.search-cancel {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: bold;
}

/* 搜索结果 */
.search-results {
  padding: 0 24rpx;
}

/* ==================== 星期标签 ==================== */
.day-tabs-fixed {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #FEFCF3;
  background-image: radial-gradient(circle, #D8D4C8 1rpx, transparent 1rpx);
  background-size: 30rpx 30rpx;
}

.day-tabs {
  display: flex;
  justify-content: space-between;
  background-color: transparent;
  padding: 16rpx 24rpx;
  gap: 8rpx;
}

.day-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  position: relative;
  transition: all 0.2s;
  background-color: #FFFFFF;
  border: 3rpx solid #1A1A1A;
  box-shadow: 3rpx 3rpx 0rpx #1A1A1A;
}

.day-tab.active {
  background-color: #C8FF00;
  color: #1A1A1A;
  border: 3rpx solid #1A1A1A;
  box-shadow: 3rpx 3rpx 0rpx #1A1A1A;
  transform: translate(-1rpx, -1rpx);
}

.day-tab.today {
  border: 3rpx solid #FF6B9D;
}

.day-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.day-date {
  display: block;
  font-size: 20rpx;
  margin-top: 4rpx;
  color: #666666;
}

.today-label {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  font-size: 18rpx;
  background-color: #FF6B9D;
  color: #FFFFFF;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  border: 2rpx solid #1A1A1A;
}

.update-badge {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  font-size: 20rpx;
  background-color: #C8FF00;
  color: #1A1A1A;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  border: 2rpx solid #1A1A1A;
  font-weight: bold;
}

/* ==================== 番剧卡片 ==================== */
.anime-list {
  padding: 16rpx 24rpx 120rpx;
  min-height: 60vh;
}

.waterfall-container {
  display: flex;
  gap: 20rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.anime-card {
  position: relative;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

.anime-card:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

.anime-cover {
  width: 100%;
  height: 100%;
  display: block;
}

/* 图片容器 */
.cover-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 133.33%;
  background-color: #E8E4D8;
  overflow: hidden;
  border-bottom: 3rpx solid #1A1A1A;
}

.cover-wrapper .anime-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 信息区域 */
.card-info {
  padding: 16rpx;
}

.anime-name {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #1A1A1A;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.episode-badge {
  font-size: 22rpx;
  color: #1A1A1A;
  background-color: #C8FF00;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 2rpx solid #1A1A1A;
  font-weight: bold;
}

.rating-badge {
  font-size: 22rpx;
  color: #1A1A1A;
}

/* 订阅按钮 */
.subscribe-float {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background-color: #C8FF00;
  color: #1A1A1A;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  z-index: 10;
  border: 3rpx solid #1A1A1A;
  font-weight: bold;
  box-shadow: 3rpx 3rpx 0rpx #1A1A1A;
}

.subscribe-float.subscribed {
  background-color: #FFFFFF;
  color: #1A1A1A;
}

.subscribe-text {
  font-size: 20rpx;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: bold;
}

/* ==================== 底部提示 ==================== */
.bottom-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 20rpx;
}

.bottom-line {
  width: 80rpx;
  height: 4rpx;
  background-color: #1A1A1A;
}

.bottom-text {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: bold;
}

/* 底部占位 */
.bottom-placeholder {
  height: 120rpx;
}

/* ==================== 返回顶部按钮 ==================== */
.back-to-top {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 88rpx;
  height: 88rpx;
  background-color: #C8FF00;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #1A1A1A;
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
  z-index: 200;
}

.back-icon {
  color: #1A1A1A;
  font-size: 40rpx;
  font-weight: bold;
}

/* ==================== Swiper ==================== */
.day-swiper {
  height: calc(100vh - 200rpx);
}

.day-scroll {
  height: 100%;
}

/* 滑动切换动画 */
.anime-list {
  transition: none;
}

.anime-list.slide-in-left {
  animation: slideInFromLeft 0.35s ease-out;
}

.anime-list.slide-in-right {
  animation: slideInFromRight 0.35s ease-out;
}

@keyframes slideInFromLeft {
  0% {
    transform: translateX(-20%);
    opacity: 0.7;
  }
  100% {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes slideInFromRight {
  0% {
    transform: translateX(20%);
    opacity: 0.7;
  }
  100% {
    transform: translateX(0);
    opacity: 1;
  }
}
