<view class="container">
  <!-- 加载动画 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-cat">🐱</text>
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中哦喵~</text>
  </view>

  <!-- 主内容 -->
  <block wx:if="{{!loading}}">
  <view class="content-fade-in">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        type="text" 
        placeholder="搜索番剧..." 
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindfocus="onSearchFocus"
        bindconfirm="doSearch"
        confirm-type="search"
      />
      <text class="clear-btn" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</text>
    </view>
    <text class="search-cancel" wx:if="{{isSearching}}" bindtap="cancelSearch">取消</text>
  </view>

  <!-- 搜索结果 -->
  <view class="search-results" wx:if="{{isSearching}}">
    <view wx:if="{{searchLoading}}" class="loading-container">
      <text class="loading-cat">🐱</text>
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中哦喵~</text>
    </view>
    <view wx:elif="{{searchResults.length > 0}}" class="waterfall-container">
      <view class="waterfall-column">
        <view 
          wx:for="{{searchLeftColumn}}"
          wx:key="id"
          class="anime-card"
          bindtap="goToDetail"
          data-id="{{item.id}}">
          <view class="cover-wrapper">
            <image class="anime-cover" src="{{item.cover}}" mode="aspectFill" lazy-load></image>
          </view>
          <view class="card-info">
            <text class="anime-name">{{item.name}}</text>
            <view class="card-meta">
              <view class="episode-badge">第{{item.currentEpisode}}集</view>
              <view class="rating-badge" wx:if="{{item.rating}}">⭐ {{item.rating}}</view>
            </view>
          </view>
          <view class="subscribe-float {{item.isSubscribed ? 'subscribed' : ''}}" catchtap="toggleSubscribe" data-id="{{item.id}}">
            <text class="subscribe-text">{{item.isSubscribed ? '已订阅' : '订阅'}}</text>
          </view>
        </view>
      </view>
      <view class="waterfall-column">
        <view 
          wx:for="{{searchRightColumn}}"
          wx:key="id"
          class="anime-card"
          bindtap="goToDetail"
          data-id="{{item.id}}">
          <view class="cover-wrapper">
            <image class="anime-cover" src="{{item.cover}}" mode="aspectFill" lazy-load></image>
          </view>
          <view class="card-info">
            <text class="anime-name">{{item.name}}</text>
            <view class="card-meta">
              <view class="episode-badge">第{{item.currentEpisode}}集</view>
              <view class="rating-badge" wx:if="{{item.rating}}">⭐ {{item.rating}}</view>
            </view>
          </view>
          <view class="subscribe-float {{item.isSubscribed ? 'subscribed' : ''}}" catchtap="toggleSubscribe" data-id="{{item.id}}">
            <text class="subscribe-text">{{item.isSubscribed ? '已订阅' : '订阅'}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">
      <text class="empty-icon">🔍</text>
      <text class="empty-text">未找到相关番剧</text>
    </view>
  </view>

  <!-- 正常列表（非搜索模式） -->
  <view wx:if="{{!isSearching}}" class="main-content">
    <!-- 星期标签（固定） -->
    <view class="day-tabs-fixed">
      <view class="day-tabs">
        <view 
          wx:for="{{weekDays}}" 
          wx:key="index"
          class="day-tab {{selectedDay == index ? 'active' : ''}} {{todayIndex == index ? 'today' : ''}} {{pressingDay == index ? 'pressing' : ''}}"
          bindtap="selectDay"
          bindtouchstart="onDayTouchStart"
          bindtouchend="onDayTouchEnd"
          data-index="{{index}}">
          <view class="update-badge" wx:if="{{item.count > 0}}">{{item.count}}</view>
          <text class="day-name">{{item.name}}</text>
          <text class="day-date">{{item.date}}</text>
        </view>
      </view>
    </view>

    <!-- Swiper 滑动切换 -->
    <swiper 
      class="day-swiper"
      current="{{selectedDay}}"
      bindchange="onSwiperChange"
      duration="300"
      skip-hidden-item-layout>
      <swiper-item wx:for="{{[0,1,2,3,4,5,6]}}" wx:key="*this">
        <scroll-view 
          scroll-y 
          enhanced
          bounces="{{false}}"
          show-scrollbar="{{false}}"
          class="day-scroll"
          bindscroll="onScroll"
          scroll-into-view="{{scrollToTop ? 'scroll-anchor' : ''}}"
          scroll-with-animation>
          <view class="anime-list">
            <view id="scroll-anchor"></view>
            <view class="waterfall-container">
              <view class="waterfall-column">
                <view 
                  wx:for="{{dayColumns[index].left}}"
                  wx:key="id"
                  class="anime-card"
                  bindtap="goToDetail"
                  data-id="{{item.id}}">
                  <view class="cover-wrapper">
                    <image class="anime-cover {{item.useHighRes ? 'cover-loaded' : ''}}" src="{{item.useHighRes ? item.cover : (item.coverLow || item.cover)}}" mode="aspectFill" lazy-load binderror="onImageError" data-id="{{item.id}}"></image>
                  </view>
                  <view class="card-info">
                    <text class="anime-name">{{item.name}}</text>
                    <text class="anime-name-en" wx:if="{{item.nameEn}}">{{item.nameEn}}</text>
                    <view class="card-meta">
                      <view class="episode-badge">第{{item.currentEpisode}}集</view>
                      <view class="rating-badge" wx:if="{{item.rating}}">⭐ {{item.rating}}</view>
                    </view>
                  </view>
                  <view class="subscribe-float {{item.isSubscribed ? 'subscribed' : ''}}" catchtap="toggleSubscribe" data-id="{{item.id}}">
                    <text class="subscribe-text">{{item.isSubscribed ? '已订阅' : '订阅'}}</text>
                  </view>
                </view>
              </view>
              <view class="waterfall-column">
                <view 
                  wx:for="{{dayColumns[index].right}}"
                  wx:key="id"
                  class="anime-card"
                  bindtap="goToDetail"
                  data-id="{{item.id}}">
                  <view class="cover-wrapper">
                    <image class="anime-cover {{item.useHighRes ? 'cover-loaded' : ''}}" src="{{item.useHighRes ? item.cover : (item.coverLow || item.cover)}}" mode="aspectFill" lazy-load binderror="onImageError" data-id="{{item.id}}"></image>
                  </view>
                  <view class="card-info">
                    <text class="anime-name">{{item.name}}</text>
                    <text class="anime-name-en" wx:if="{{item.nameEn}}">{{item.nameEn}}</text>
                    <view class="card-meta">
                      <view class="episode-badge">第{{item.currentEpisode}}集</view>
                      <view class="rating-badge" wx:if="{{item.rating}}">⭐ {{item.rating}}</view>
                    </view>
                  </view>
                  <view class="subscribe-float {{item.isSubscribed ? 'subscribed' : ''}}" catchtap="toggleSubscribe" data-id="{{item.id}}">
                    <text class="subscribe-text">{{item.isSubscribed ? '已订阅' : '订阅'}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view wx:if="{{dayAnimeList[index].length === 0}}" class="empty-state">
              <text class="empty-icon">📅</text>
              <text class="empty-text">今日无更新</text>
            </view>
            
            <view wx:if="{{dayAnimeList[index].length > 0}}" class="bottom-tip">
              <text class="bottom-line"></text>
              <text class="bottom-text">已经到底啦喵~</text>
              <text class="bottom-line"></text>
            </view>
            
            <view class="bottom-placeholder"></view>
          </view>
        </scroll-view>
      </swiper-item>
    </swiper>
  </view>
  </view>
  </block>

  <!-- 返回顶部按钮 -->
  <view class="back-to-top" wx:if="{{showBackTop}}" bindtap="goToTop">
    <text class="back-icon">↑</text>
  </view>
</view>
