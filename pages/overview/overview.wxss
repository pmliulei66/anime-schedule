.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #FEFCF3;
  background-image: radial-gradient(#1A1A1A 1rpx, transparent 1rpx);
  background-size: 24rpx 24rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  padding: 20rpx 24rpx;
  background-color: #ffffff;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

.search-input {
  flex: 1;
  height: 70rpx;
  background-color: #FEFCF3;
  border-radius: 16rpx;
  border: 4rpx solid #1A1A1A;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.search-btn {
  width: 120rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: bold;
  background-color: #C8FF00;
  border: 4rpx solid #1A1A1A;
  border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

.search-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

/* 筛选标签 */
.filter-tabs {
  white-space: nowrap;
  padding: 20rpx 24rpx;
  background-color: #ffffff;
  border: 4rpx solid #1A1A1A;
}

.filter-tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  background-color: #FEFCF3;
  border-radius: 16rpx;
  border: 4rpx solid #1A1A1A;
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

.filter-tab:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0rpx #1A1A1A;
}

.filter-tab.active {
  background-color: #C8FF00;
  color: #1A1A1A;
  font-weight: bold;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

/* 视图切换 */
.view-toggle {
  display: flex;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border: 4rpx solid #1A1A1A;
}

.toggle-btn {
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  border-radius: 16rpx;
}

.toggle-btn.active {
  color: #1A1A1A;
  font-weight: bold;
  background-color: #C8FF00;
  border: 4rpx solid #1A1A1A;
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

/* 番剧容器 */
.anime-container {
  flex: 1;
  padding: 20rpx 24rpx;
}

/* 网格视图 */
.anime-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.anime-grid-item {
  width: calc(50% - 10rpx);
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

.grid-cover {
  width: 100%;
  height: 280rpx;
}

.grid-info {
  padding: 16rpx;
}

.grid-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-meta {
  display: block;
  font-size: 22rpx;
  color: #1A1A1A;
}

.grid-subscribe {
  padding: 12rpx;
  text-align: center;
  font-size: 24rpx;
  background-color: #C8FF00;
  color: #1A1A1A;
  font-weight: bold;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

.grid-subscribe:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

.grid-subscribe.subscribed {
  background-color: #C8FF00;
}

/* 列表视图 */
.anime-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.anime-list-item {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

.list-cover {
  width: 140rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  border: 4rpx solid #1A1A1A;
}

.list-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.list-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.list-name-jp {
  font-size: 24rpx;
  color: #1A1A1A;
  margin-top: 6rpx;
}

.list-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.list-platform {
  background-color: #C8FF00;
  color: #1A1A1A;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  border: 4rpx solid #1A1A1A;
  font-weight: bold;
}

.list-time {
  font-size: 24rpx;
  color: #1A1A1A;
}

.list-genres {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.genre-tag {
  background-color: #E8E4D8;
  color: #1A1A1A;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  border: 4rpx solid #1A1A1A;
}

.list-subscribe {
  width: 100rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background-color: #C8FF00;
  color: #1A1A1A;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
  align-self: center;
  flex-shrink: 0;
}

.list-subscribe:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

.list-subscribe.subscribed {
  background-color: #C8FF00;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #1A1A1A;
}
