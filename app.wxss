/* ==================== 新粗野主义 (Neo-Brutalism) 全局样式 ==================== */

page {
  background-color: #FEFCF3;
  /* 点阵纸背景 */
  background-image: radial-gradient(circle, #D8D4C8 1rpx, transparent 1rpx);
  background-size: 30rpx 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
  color: #1A1A1A;
}

.container {
  min-height: 100vh;
  padding: 20rpx;
}

/* ==================== 全局加载动画 ==================== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  animation: fadeIn 0.4s ease;
}

.content-fade-in {
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #1A1A1A;
  border-top-color: #C8FF00;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: bold;
}

.loading-cat {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  animation: bounce 0.6s ease-in-out infinite alternate;
}

@keyframes bounce {
  from { transform: translateY(0); }
  to { transform: translateY(-10rpx); }
}

/* ==================== 卡片 ==================== */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

/* ==================== 按钮 ==================== */
.btn-primary {
  background-color: #C8FF00;
  color: #1A1A1A;
  border-radius: 16rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: 4rpx solid #1A1A1A;
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

.btn-primary:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0rpx #1A1A1A;
}

.btn-secondary {
  background-color: #FFFFFF;
  color: #1A1A1A;
  border-radius: 16rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: 4rpx solid #1A1A1A;
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

.btn-secondary:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0rpx #1A1A1A;
}

/* ==================== 文本 ==================== */
.text-primary {
  color: #C8FF00;
}

.text-secondary {
  color: #999999;
}

.text-bold {
  font-weight: bold;
}
