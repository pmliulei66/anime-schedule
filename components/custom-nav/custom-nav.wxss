.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background-color: #FEFCF3;
  border-bottom: 4rpx solid #1A1A1A;
  box-shadow: 6rpx 6rpx 0rpx #1A1A1A;
}

.nav-content {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  position: relative;
}

.nav-left {
  width: 120rpx;
  display: flex;
  align-items: center;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  border: 4rpx solid #1A1A1A;
  background-color: #ffffff;
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

.nav-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0rpx #1A1A1A;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #1A1A1A;
  border-bottom: 4rpx solid #1A1A1A;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-logo-wrap {
  display: flex;
  align-items: center;
  padding: 8rpx;
}

.nav-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  border: 4rpx solid #1A1A1A;
  box-shadow: 4rpx 4rpx 0rpx #1A1A1A;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 120rpx;
  color: #1A1A1A;
}

.nav-right {
  width: 120rpx;
}
