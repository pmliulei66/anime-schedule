<view class="custom-nav" style="background-color: {{bgColor}}; color: {{textColor}};">
  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>
  
  <!-- 导航栏内容 -->
  <view class="nav-content" style="height: {{navHeight}}px;">
    <!-- 左侧区域 -->
    <view class="nav-left">
      <block wx:if="{{showBack}}">
        <view class="nav-btn" bindtap="onBack">
          <view class="back-arrow"></view>
        </view>
      </block>
      <block wx:else>
        <!-- Logo Icon -->
        <view class="nav-logo-wrap" bindtap="onHome">
          <image class="nav-logo" src="/assets/nav-icon.png" mode="aspectFit"></image>
        </view>
      </block>
    </view>
    
    <!-- 标题 -->
    <view class="nav-title">{{title}}</view>
    
    <!-- 右侧占位（与胶囊按钮对齐） -->
    <view class="nav-right"></view>
  </view>
</view>

<!-- 占位区域，防止内容被导航栏遮挡 -->
<view style="height: {{totalNavHeight}}px;"></view>
